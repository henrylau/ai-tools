# Lighter CUDA image using llm2jev Transformers backend (no SGLang).
# Prefer the main Dockerfile (SGLang) for throughput; use this if SGLang
# install fails on your CUDA stack.
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
FROM ${CUDA_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    MODEL_ID=huihui-ai/Huihui-Qwen3.5-2B-abliterated \
    MODEL_PATH=/models/huihui-ai/Huihui-Qwen3.5-2B-abliterated \
    SERVED_MODEL_NAME=local-model \
    HOST=0.0.0.0 \
    PORT=30000 \
    DOWNLOAD_MODEL_ON_START=1 \
    DTYPE=bfloat16

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git python3.12 python3.12-venv python3.12-dev \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -sf /root/.local/bin/uv /usr/local/bin/uv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/llm2jev
ARG LLM2JEV_REPO=https://github.com/Yinsongxu/LLM2Jev.git
ARG LLM2JEV_REF=main
RUN git clone --depth 1 --branch "${LLM2JEV_REF}" "${LLM2JEV_REPO}" . \
    && uv venv /opt/venv \
    && . /opt/venv/bin/activate \
    && uv pip install -U pip \
    && uv sync --extra transformers \
    && uv pip install huggingface_hub \
    && rm -rf /root/.cache/uv /root/.cache/pip

ENV PATH=/opt/venv/bin:$PATH VIRTUAL_ENV=/opt/venv
VOLUME ["/models"]
EXPOSE 30000
COPY entrypoint-transformers.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
